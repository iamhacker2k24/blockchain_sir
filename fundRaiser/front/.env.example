# ============================================================================
# Web3 Fundraiser Frontend - Environment Configuration
# ============================================================================

# (Optional) The deployed CampaignFactory contract address
# When you run `npx hardhat run scripts/Depoly.ts --network amoy`, this is automatically updated in contractConfig.json!
VITE_FACTORY_ADDRESS=

# (Optional) Private key for deploying contracts from your wallet via Hardhat CLI
# NEVER commit your real private key to GitHub!
PRIVATE_KEY=

# RPC URL for Polygon Amoy Testnet (Chain ID 80002)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology/

# RPC URL for Ethereum Sepolia Testnet (Chain ID 11155111)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
